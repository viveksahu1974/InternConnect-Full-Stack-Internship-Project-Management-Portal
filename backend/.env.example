PORT=5000
NODE_ENV=development

# Database — SQLite is used out of the box for zero-setup local dev/demo.
# To use MySQL instead: set DB_DIALECT=mysql and fill in the MySQL vars.
# Sequelize models/migrations are written to work unchanged on either.
DB_DIALECT=sqlite
DB_STORAGE=./data/internconnect.sqlite

DB_HOST=localhost
DB_PORT=3306
DB_NAME=internconnect
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace-with-a-different-strong-random-secret
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
